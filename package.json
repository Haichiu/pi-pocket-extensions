{
    "name": "pi-pocket-extensions",
    "version": "1.0.0",
    "description": "The index of Pi Pocket extensions: reviewed drop-ins, pinned to a commit",
    "private": true,
    "type": "module",
    "license": "MIT",
    "author": "Tanner Middleton",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/TannerMidd/pi-pocket-extensions.git"
    },
    "engines": {
        "node": ">=22.18"
    },
    "scripts": {
        "build": "node scripts/build-index.ts",
        "validate": "node scripts/validate.ts --pocket ${POCKET_DIR:-pi-pocket}",
        "test": "node --test test/*.test.ts"
    }
}
