{
    "name": "update-notifier",
    "title": "Pocket updates",
    "description": "Notify the owner when a newer stable Pi Pocket release is available. Compares the running server version with the fixed public GitHub release API. Checks while an owner has Pocket open, caches results and rate-limit waits, and supports manual checks and dismissal. Uses only its own durable documents. Sends no credentials or user content. Does not install updates, run Git, restart Pocket, or call a model.",
    "tags": [
        "updates",
        "notifications",
        "versions"
    ],
