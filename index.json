            ],
            "pocketApi": 1,
            "minPocket": "0.15.0",
            "declares": {
                "extensions": [
                    "mcp"
                ],
                "tools": [
                    "mcp_tools",
                    "mcp_call",
                    "mcp_call_read_only"
                ],
                "readOnlyTools": [
                    "mcp_tools",
                    "mcp_call_read_only"
                ],
                "hooks": [],
                "sections": [
                    "mcp"
                ],
                "wraps": [],
                "routes": [
                    "GET state",
                    "POST reload",
                    "POST servers/:name/on",
                    "POST servers/:name/plan-mode",
                    "POST servers/:name/reconnect",
                    "POST servers/:name/sign-in",
                    "POST servers/:name/sign-in/paste",
                    "POST servers/:name/sign-in/cancel",
                    "POST servers/:name/sign-out"
                ],
                "client": "owner",
                "access": "owner"
            }
        },
        {
            "name": "project-workbench",
            "title": "Project workbench",
            "description": "An owner-only project workbench: reads the bound session's package.json and Git metadata, runs Git status/worktree queries, and starts npm scripts only after owner confirmation. Scripts and npm may read files, secrets, environment variables and network services with the server user's rights. Stores preview settings in a namespaced document and bounded run results under the data folder. Preview links are user-entered loopback HTTP(S); no service discovery or external requests by the extension.",
            "tags": [
                "project",
                "git",
                "npm",
                "scripts",
                "preview"
            ],
            "author": {
                "name": "Tanner Middleton",
                "github": "TannerMidd"
            },
