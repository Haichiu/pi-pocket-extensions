        {
            "name": "agent-recipes",
            "title": "Agent recipes",
            "description": "Save owner-managed, read-only team recipes and start approved roles as linked sessions. Uses only module documents, the owner's allowed-model list, and the experimental linked-session APIs. Reads no outside files or secrets and makes no direct network calls or processes. Linked agents can use their normal tools and model providers; prompts are not a sandbox.",
            "tags": [
                "agents",
                "recipes",
                "review",
                "teams"
            ],
            "author": {
                "name": "Tanner Middleton",
                "github": "TannerMidd"
            },
            "version": "0.1.0",
