                    "agent-recipes"
                ],
                "tools": [
                    "agent_recipes_list",
                    "agent_recipes_get",
                    "agent_recipes_draft",
                    "agent_recipes_invoke",
                    "agent_recipes_status"
                ],
                "readOnlyTools": [
                    "agent_recipes_list",
