{
    "format": 1,
    "name": "Pi Pocket extensions",
    "repo": "https://github.com/TannerMidd/pi-pocket-extensions",
    "extensions": [
        {
            "name": "mcp",
            "title": "MCP servers",
            "description": "MCP servers for Pi: Pi Pocket connects to the stdio and HTTP servers in Pi's own mcp.json, and Pi finds and calls their tools with mcp_tools, mcp_call, and mcp_call_read_only. Each server is a program that runs with the owner's rights, and Lancet Guard does not check the calls of its tools. A server runs only after the owner turns it on in the MCP page, and again after each change to its entry. The module reads ~/.pi/agent/mcp.json and the variables and commands that its entries name, and keeps its settings and OAuth tokens in ~/.pi-pocket/mcp/.",
            "tags": [
                "mcp",
                "tools",
                "integration",
                "oauth"
            ],
            "author": {
                "name": "Tanner Middleton",
                "github": "TannerMidd"
            },
            "version": "0.1.0",
            "source": {
                "repo": "TannerMidd/pocket-mcp",
                "commit": "1c532c636e097efe45a48c5cf352ae9c20dc846c",
                "path": ""
            },
            "files": [
                {
                    "name": "mcp.ts",
                    "sha256": "1120a07b0a2b207029187c222604960e359837a3c181a44d24154e3f2d5c694d",
                    "size": 33887
                },
                {
                    "name": "mcp/config.ts",
                    "sha256": "9ca63e9e0a6057e606e0213c868fff94c61424ecda8d96f48d1d589f9ee2957c",
                    "size": 20877
                },
                {
                    "name": "mcp/connection.ts",
                    "sha256": "3919a676c066785985f40206abe6eaedb700c185aa8744e08efd34cfd4bf30ec",
                    "size": 17373
                },
                {
                    "name": "mcp/index.js",
                    "sha256": "1a5f280eaf49159205b054f0c5fbea70f75156768512801a6fa00ce8f40d291d",
                    "size": 15926
                },
                {
                    "name": "mcp/oauth.ts",
                    "sha256": "772208a0fd54689b64f54c7f770c552b3dd9c2a0b7a679a4ff7a048bac8dbb7b",
                    "size": 20180
                },
                {
                    "name": "mcp/style.css",
                    "sha256": "eb0a4be7862eecd704415da8cb1fa9c1347049bdddcea9ab7ff069a4f81d79d8",
                    "size": 3262
                }
            ],
            "pocketApi": 1,
            "minPocket": "0.15.0",
            "declares": {
                "extensions": [
                    "mcp"
                ],
                "tools": [
                    "mcp_tools",
                    "mcp_call",
                    "mcp_call_read_only"
                ],
                "readOnlyTools": [
                    "mcp_tools",
                    "mcp_call_read_only"
                ],
                "hooks": [],
                "sections": [
                    "mcp"
                ],
                "wraps": [],
                "routes": [
                    "GET state",
                    "POST reload",
                    "POST servers/:name/on",
                    "POST servers/:name/plan-mode",
                    "POST servers/:name/reconnect",
                    "POST servers/:name/sign-in",
                    "POST servers/:name/sign-in/paste",
                    "POST servers/:name/sign-in/cancel",
                    "POST servers/:name/sign-out"
                ],
                "client": "owner",
                "access": "owner"
            }
        },
        {
            "name": "subscription-usage",
            "title": "Subscription usage",
            "description": "Subscription usage: a page on the rail with how much of your Claude, ChatGPT (Codex), and OpenCode Go plans is used, and when each limit resets. The server asks each service with the sign-ins already on this machine, so no key or token reaches the browser.",
