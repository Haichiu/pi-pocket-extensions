{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/TannerMidd/pi-pocket-extensions/schema/theme.schema.json",
    "title": "Pi Pocket theme index entry (format 1)",
    "$comment": "A copy of the rules of parseThemeEntry in Pi Pocket's src/server/gallery/entry.ts (0.14.0 and newer), for editors and for build-index. Where they differ, entry.ts is correct. These rules join two fields, so only parseThemeEntry checks them: each file name is in <name>/; files has <name>/theme.css, <name>/colors.toml, or <name>/colors-light.toml, and <name>/theme.json when it has theme.css; theme.json, colors.toml, and colors-light.toml are 8 KiB each at most; the CSS files are 256 KiB together at most, and all files 16 MiB; no two file names differ only in case; no file name is also a folder of another file. What the CSS does is checked by Pi Pocket's theme check (scripts/validate.ts runs it), and again by Pi Pocket when it installs the theme. The reserved ids here are Pi Pocket 0.14.0's; parseThemeEntry has the current list (Pi Pocket can keep new ones in a minor release).",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "kind",
        "name",
        "title",
        "description",
        "tags",
        "author",
        "version",
        "source",
        "files",
        "themeApi",
        "minPocket"
    ],
    "properties": {
        "kind": {
            "description": "This entry is a theme. An entry with no kind is an extension.",
            "const": "theme"
        },
        "name": {
            "description": "The theme's id: the name of its folder. Not an id that Pi Pocket keeps: desktop, a theme that comes with Pi Pocket (pocket, lantern), or one of its palettes.",
            "type": "string",
            "maxLength": 48,
            "pattern": "^(?!(?:desktop|pocket|lantern|catppuccin|catppuccin-latte|ethereal|everforest|flexoki-light|gruvbox|hackerman|kanagawa|last-horizon|lumon|lupine|matte-black|miasma|nord|osaka-jade|retro-82|ristretto|rose-pine|solitude|tokyo-night|vantablack|white)$)[a-z0-9][a-z0-9-]{1,47}$"
        },
        "title": {
            "$ref": "#/$defs/line",
            "maxLength": 60
        },
        "description": {
            "$ref": "#/$defs/line",
            "maxLength": 600
        },
        "tags": {
            "type": "array",
            "maxItems": 10,
            "uniqueItems": true,
            "items": {
                "type": "string",
                "maxLength": 24,
                "pattern": "^[a-z0-9][a-z0-9-]{0,23}$"
            }
        },
        "author": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
                "name": {
                    "$ref": "#/$defs/line",
                    "maxLength": 60
                },
                "github": {
                    "type": "string",
                    "maxLength": 39,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$"
                }
            }
        },
        "version": {
            "type": "string",
            "maxLength": 32,
            "pattern": "^[0-9A-Za-z][0-9A-Za-z.+-]{0,31}$"
        },
        "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repo", "commit"],
            "properties": {
                "repo": {
                    "type": "string",
                    "maxLength": 140,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}/(?!\\.\\.?$)[A-Za-z0-9._-]{1,100}$"
                },
                "commit": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                },
                "path": {
                    "type": "string",
                    "maxLength": 200,
                    "pattern": "^(?:[A-Za-z0-9_][A-Za-z0-9._-]{0,99}(?:/[A-Za-z0-9_][A-Za-z0-9._-]{0,99}){0,3})?$"
                }
            }
        },
        "files": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "uniqueItems": true,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "sha256", "size"],
                "properties": {
                    "name": {
                        "description": "Its path in the theme's folder, with the folder: <name>/theme.css. theme.json, colors.toml, and colors-light.toml at the top of the folder, and .css, .woff2, .png, .jpg, .jpeg, .webp, .avif, .gif, and .svg files, four folders deep at most.",
                        "type": "string",
                        "maxLength": 200,
                        "pattern": "^[a-z0-9][a-z0-9-]{1,47}/(?:theme\\.json|colors\\.toml|colors-light\\.toml|(?:(?!node_modules/)[A-Za-z0-9_][A-Za-z0-9._-]{0,99}/){0,4}(?!node_modules$)[A-Za-z0-9_][A-Za-z0-9._-]{0,99}\\.(?:[cC][sS][sS]|[wW][oO][fF][fF]2|[pP][nN][gG]|[jJ][pP][eE]?[gG]|[wW][eE][bB][pP]|[aA][vV][iI][fF]|[gG][iI][fF]|[sS][vV][gG]))$"
                    },
                    "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                    },
                    "size": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4194304
                    }
                }
            }
        },
        "themeApi": {
            "description": "The version of the theme surface that the theme needs. Now this is 1.",
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
        },
        "minPocket": {
            "type": "string",
            "maxLength": 14,
            "pattern": "^\\d{1,4}\\.\\d{1,4}\\.\\d{1,4}$"
        },
        "revoked": {
            "type": "array",
            "maxItems": 50,
            "uniqueItems": true,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["commit", "reason"],
                "properties": {
                    "commit": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{40}$"
                    },
                    "reason": {
                        "$ref": "#/$defs/line",
                        "maxLength": 300
                    }
                }
            }
        }
    },
    "$defs": {
        "line": {
            "description": "One line of plain text: not empty, no spaces at the ends, no control, invisible, or direction characters.",
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\s\\u0000-\\u001f\\u007f-\\u009f\\u00ad\\u061c\\u180e\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u206f\\ufeff](?:[^\\u0000-\\u001f\\u007f-\\u009f\\u00ad\\u061c\\u180e\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u206f\\ufeff]*[^\\s\\u0000-\\u001f\\u007f-\\u009f\\u00ad\\u061c\\u180e\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u206f\\ufeff])?$"
        }
    }
}
